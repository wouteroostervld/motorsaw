# Motorsaw Daemon - Systemd User Service Unit

[Unit]
Description=Motorsaw GraphRAG Indexing Daemon
Documentation=https://github.com/wouteroostervld/motorsaw
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/motorsaw daemon start
# "systemctl --user reload motorsawd" after changing ~/.motorsaw/config.yaml:
# the daemon reads it again, without stopping
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

# Graceful shutdown - allow time for WAL flush and queue cleanup
TimeoutStopSec=30s
KillMode=mixed
KillSignal=SIGTERM

# Environment
Environment=HOME=%h

# Resource limits (adjust based on your needs)
# Limit memory to 2GB
MemoryMax=2G
# Limit CPU to 80%
CPUQuota=80%

# Security hardening
# NoNewPrivileges prevents privilege escalation
NoNewPrivileges=true
# PrivateTmp gives the service a private /tmp
PrivateTmp=true
# Restrict filesystem access to home directory only
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.motorsaw

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=motorsawd

[Install]
WantedBy=default.target
